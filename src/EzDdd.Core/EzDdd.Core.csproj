<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\EzDdd.Common\EzDdd.Common.csproj" />
    <ProjectReference Include="..\EzDdd.Entity\EzDdd.Entity.csproj" />
    <ProjectReference Include="..\EzDdd.UseCase\EzDdd.UseCase.csproj" />
    <ProjectReference Include="..\EzDdd.Cqrs\EzDdd.Cqrs.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>

    <!-- Package Information -->
    <PackageId>ezDDD.Core</PackageId>
    <Version>1.0.0-alpha.1</Version>
    <Authors>TeddySoft</Authors>
    <Company>TeddySoft</Company>
    <Description>All-in-one package for ezDDD.NET - Tactical Domain-Driven Design patterns, CQRS, Event Sourcing, and Clean Architecture for .NET</Description>
    <PackageTags>ddd;domain-driven-design;cqrs;event-sourcing;clean-architecture;aggregate-root;tactical-ddd</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/TeddyChen/ezddd.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/TeddyChen/ezddd.NET</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Build Settings -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
