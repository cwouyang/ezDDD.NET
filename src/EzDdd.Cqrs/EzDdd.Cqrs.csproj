<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\EzDdd.UseCase\EzDdd.UseCase.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Target Framework -->
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>

    <!-- Code Quality -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!-- Assembly Information -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Copyright>Copyright (c) 2025-2026 ezDDD.NET Contributors</Copyright>

    <!-- Package Metadata -->
    <PackageId>ezDDD.Cqrs</PackageId>
    <Version>1.0.0-alpha.1</Version>
    <Authors>TeddySoft</Authors>
    <Company>TeddySoft</Company>
    <Product>ezDDD.NET</Product>
    <Description>CQRS patterns for ezDDD.NET - Command, Query, Projection, Projector, and Archive interfaces.

Features:
• ICommand&lt;TInput, TOutput&gt; - Write operations marker
• IQuery&lt;TInput, TOutput&gt; - Read operations marker
• IInquiry&lt;TInput, TOutput&gt; - Validation queries usable within commands
• IProjection&lt;TInput, TOutput&gt; - Read model builder
• IProjector&lt;TInput&gt; - Reactor that maintains read models in the query database
• INotifier&lt;TInput&gt; - Reactor that dispatches external domain events (integration events)
• IArchive&lt;TData, TId&gt; - Query database interface (read-side repository)
• CqrsOutput&lt;T&gt; - Unified output with fluent API
• Generic variance (contravariant input, covariant output)

Enables Command Query Responsibility Segregation with eventual consistency.</Description>
    <PackageTags>ddd;domain-driven-design;cqrs;command;query;projection;read-model;archive;inquiry;dotnet;csharp</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/TeddyChen/ezddd.NET</PackageProjectUrl>
    <RepositoryUrl>https://github.com/TeddyChen/ezddd.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>See https://github.com/TeddyChen/ezddd.NET/blob/master/CHANGELOG.md for release notes.</PackageReleaseNotes>

    <!-- Documentation -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\EzDdd.Cqrs.xml</DocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Symbols and Debugging -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
