<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\EzDdd.Common\EzDdd.Common.csproj" />
    <ProjectReference Include="..\..\..\uContract.NET\src\uContract\uContract.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>

    <!-- Package Information -->
    <PackageId>ezDDD.Entity</PackageId>
    <Version>1.0.0-alpha.1</Version>
    <Authors>TeddySoft</Authors>
    <Company>TeddySoft</Company>
    <Description>Core DDD tactical patterns for ezDDD.NET - Entity, AggregateRoot, EsAggregateRoot, DomainEvent</Description>
    <PackageTags>ddd;domain-driven-design;aggregate-root;entity;value-object;domain-events;event-sourcing</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/TeddyChen/ezddd.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/TeddyChen/ezddd.NET</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Build Settings -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
