<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\EzDdd.Entity\EzDdd.Entity.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Target Framework -->
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>

    <!-- Code Quality -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!-- Assembly Information -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Copyright>Copyright (c) 2025-2026 ezDDD.NET Contributors</Copyright>

    <!-- Package Metadata -->
    <PackageId>ezDDD.UseCase</PackageId>
    <Version>1.0.0-alpha.1</Version>
    <Authors>TeddySoft</Authors>
    <Company>TeddySoft</Company>
    <Product>ezDDD.NET</Product>
    <Description>Use cases and repository patterns for ezDDD.NET - Clean Architecture support with event sourcing and state sourcing.

Features:
• IUseCase&lt;TInput, TOutput&gt; - Command pattern interface
• IRepository/IRepositoryPeer - Bridge pattern for persistence abstraction
• EsRepository - Generic event sourcing repository with reflection optimization
• OutboxRepository - State sourcing with Transactional Outbox pattern
• DomainEventMapper - Event serialization/deserialization
• Transaction boundary enforcement
• Async/await throughout

Implements Clean Architecture layers with tactical DDD patterns.</Description>
    <PackageTags>ddd;domain-driven-design;clean-architecture;use-case;repository;event-sourcing;state-sourcing;outbox-pattern;dotnet;csharp</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/TeddyChen/ezddd.NET</PackageProjectUrl>
    <RepositoryUrl>https://github.com/TeddyChen/ezddd.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>See https://github.com/TeddyChen/ezddd.NET/blob/master/CHANGELOG.md for release notes.</PackageReleaseNotes>

    <!-- Documentation -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\EzDdd.UseCase.xml</DocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Symbols and Debugging -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
